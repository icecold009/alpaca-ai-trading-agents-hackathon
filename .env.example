# Safe default: recorded fixtures, no external credentials required.
RISKCOURT_MODE=recorded

# Alpaca paper trading only. Leave credentials blank in this tracked file.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Defense-in-depth startup guards. Setting either flag to true aborts startup.
RISKCOURT_LIVE_TRADING=false
ALPACA_LIVE_TRADING=false

# Restart-safe paper state and exact public frontend origins (optional).
RISKCOURT_STATE_DIR=.riskcourt
RISKCOURT_ALLOWED_ORIGINS=

# Optional TypeSafe AI juror provider. Deterministic is the safe default.
RISKCOURT_AI_MODE=deterministic
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=10
TYPESAFE_MAX_CALLS=3
TYPESAFE_MAX_COST_UNITS=3
TYPESAFE_MIN_EVIDENCE_QUALITY=0.60

# TypeSafe credentials remain server-side and are never printed or persisted in
# RiskCourt events. Shadow mode never changes the deterministic decision.
