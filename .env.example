# Safe default: recorded fixtures, no external credentials required.
RISKCOURT_MODE=recorded

# Alpaca paper trading only. Leave credentials blank in this tracked file.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Defense-in-depth startup guards. Setting either flag to true aborts startup.
RISKCOURT_LIVE_TRADING=false
ALPACA_LIVE_TRADING=false

# Restart-safe paper state and exact public frontend origins (optional).
RISKCOURT_STATE_DIR=.riskcourt
RISKCOURT_ALLOWED_ORIGINS=

# Model-provider credentials are intentionally not loaded by RiskCourt Settings.
# Configure them only inside the private provider module passed to
# `run_paper_cycle.py --provider module:attribute`.
