# Safe default: recorded fixtures, no external credentials required.
RISKCOURT_MODE=recorded

# Alpaca paper trading only. Leave credentials blank in this tracked file.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Defense-in-depth startup guards. Setting either flag to true aborts startup.
RISKCOURT_LIVE_TRADING=false
ALPACA_LIVE_TRADING=false

# Provider-neutral model configuration. Select a provider before paper mode.
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
